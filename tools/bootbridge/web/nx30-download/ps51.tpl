& { $ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue'; [Net.ServicePointManager]::SecurityProtocol=[Net.ServicePointManager]::SecurityProtocol -bor 3072; $sn='__SN__'; $want='NX30V100R012'; $sha='61fbc2a356aa9d5d73eaa9f02eb87f455adea8c32684ffb627b2a35afc2ce922'; $size=31981568; $api='https://magic.h3c.com/smarthomeback/rest/ihomers/getGwDownloadNew'; $u=$null; $code='?'; $got=''; Write-Host '[1/3] 向 H3C 查询 R012 下载链接...'; foreach($v in 'NX30V100R011','NX30V100R012'){ try { $r=Invoke-RestMethod -Method Post -Uri $api -ContentType 'application/json' -Body ('{"gwVer":"'+$v+'","gwSn":"'+$sn+'","gwAskCount":0}') -TimeoutSec 30 } catch { Write-Host ('无法连接 H3C：'+$_.Exception.Message) -ForegroundColor Red; return }; $code="$($r.retCode)"; $got="$($r.gwBestVer)"; if($code -eq '0' -and $got -eq $want -and "$($r.VerURL)" -match '^https?://h3c-magic\.oss-cn-hangzhou\.aliyuncs\.com/\S+$'){ $u=$r.VerURL -replace '^http://','https://'; break } }; if(-not $u){ Write-Host "H3C 没有给出 R012 下载链接（retCode=$code，版本=$got）" -ForegroundColor Red; return }; $dir=Join-Path $env:USERPROFILE 'Downloads'; if(-not (Test-Path -LiteralPath $dir)){ $dir=$env:USERPROFILE }; $f=Join-Path $dir 'NX30V100R012.bin'; $tmp="$f.part"; Write-Host '[2/3] 从 H3C 官方下载（约 31 MB）...'; try { Invoke-WebRequest -Uri $u -OutFile $tmp -UseBasicParsing -TimeoutSec 600 } catch { Remove-Item -LiteralPath $tmp -ErrorAction SilentlyContinue; Write-Host ('下载失败：'+$_.Exception.Message) -ForegroundColor Red; return }; Write-Host '[3/3] 校验文件...'; $len=(Get-Item -LiteralPath $tmp).Length; $h=(Get-FileHash -LiteralPath $tmp -Algorithm SHA256).Hash.ToLower(); if($len -ne $size -or $h -ne $sha){ Remove-Item -LiteralPath $tmp; Write-Host "校验失败，已删除：大小 $len，SHA256 $h" -ForegroundColor Red; return }; Move-Item -LiteralPath $tmp -Destination $f -Force; Write-Host "完成：$f" -ForegroundColor Green; Write-Host "SHA256 $h" }
