/* Numeric RT_MANIFEST avoids a header dependency in the resource compiler. */
1 24 "app.manifest"

/* Keep this in sync with app.manifest and VERSIONINFO in release checks. */
#define BB_VERSION 0,4,0,0
#define BB_VERSION_STRING "0.4.0.0"

1 VERSIONINFO
FILEVERSION BB_VERSION
PRODUCTVERSION BB_VERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BootBridge contributors"
            VALUE "FileDescription", "BootBridge Offline Windows GUI"
            VALUE "FileVersion", BB_VERSION_STRING
            VALUE "InternalName", "BootBridge-Offline"
            VALUE "LegalCopyright", "GPL-2.0-or-later"
            VALUE "OriginalFilename", "BootBridge-Offline.exe"
            VALUE "ProductName", "BootBridge"
            VALUE "ProductVersion", BB_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
